{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "bench.py (prompt)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/bench.py",
            "console": "integratedTerminal",
            "args": [
                "${command:pickArgs}"
            ]
        },
        {
            "name": "bench.py popl25",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/bench.py",
            "console": "integratedTerminal",
            "args": [
                "popl25"
            ]
        },
        {
            "name": "bench.py popl25quick-*",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/bench.py",
            "console": "integratedTerminal",
            "args": [
                "popl25quick-feynman",
                "popl25quick-feynman-apf",
                "popl25quick-feynman-ppf",
                "popl25quick-feynman-pyzx",
                "popl25quick-mlvoqc",
                "popl25quick-pyzx",
                "popl25quick-pyzx-todd",
                "popl25quick-quartz",
                "popl25quick-queso",
                "popl25quick-vv-qco-bbmerge",
                "popl25quick-vv-qco-fasttmerge",
                "popl25quick-vv-qco-internalhopt",
                "popl25quick-vv-qco-tohpe",
                "popl25quick-vv-qco-fasttodd"
            ]
        },
        {
            "name": "bench.py popl25slow-feynman",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/bench.py",
            "console": "integratedTerminal",
            "args": [
                "popl25slow-feynman"
            ]
        },
        {
            "name": "bench.py popl25slow-feynman-apf",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/bench.py",
            "console": "integratedTerminal",
            "args": [
                "popl25slow-feynman-apf"
            ]
        },
        {
            "name": "bench.py popl25slow-feynman-ppf",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/bench.py",
            "console": "integratedTerminal",
            "args": [
                "popl25slow-feynman-ppf"
            ]
        },
        {
            "type": "java",
            "name": "QUESO Optimizer",
            "request": "launch",
            "mainClass": "Optimizer",
            "args": [
                "-c",
                "${workspaceFolder}/bench/resources/qc/mod_adder_1024.qc",
                "-g",
                "nam",
                "-r",
                "rules_q3_s6_nam.txt",
                "-sr",
                "rules_q3_s6_nam_symb.txt",
                "-t",
                "45"
            ]
        },
        {
            "name": "(gdb) TOpt ../tof_3_opt",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/topt/bin/TOpt",
            "args": [
                "circuit",
                "tof_3_opt.qc",
                "-o",
                "tof_3_opt.sqc"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}